class Solution:
    def sumSubarrayMins(self, arr):
        MOD = 10**9 + 7
        n = len(arr)
        
        # Previous Less Element (PLE)
        ple = [0] * n
        stack = []
        for i in range(n):
            while stack and arr[stack[-1]] > arr[i]:
                stack.pop()
            ple[i] = i - stack[-1] if stack else i + 1
            stack.append(i)
        
        # Next Less or Equal Element (NLE)
        nle = [0] * n
        stack = []
        for i in range(n-1, -1, -1):
            while stack and arr[stack[-1]] >= arr[i]:
                stack.pop()
            nle[i] = stack[-1] - i if stack else n - i
            stack.append(i)
        
        # Contribution
        result = 0
        for i in range(n):
            result = (result + arr[i] * ple[i] * nle[i]) % MOD
        
        return result
