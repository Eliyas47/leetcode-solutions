class Solution:
    def eventualSafeNodes(self, graph):
        n = len(graph)
        state = [0] * n  # 0=unvisited, 1=visiting, 2=safe

        def dfs(node):
            if state[node] != 0:
                return state[node] == 2
            state[node] = 1  # mark as visiting
            for nei in graph[node]:
                if not dfs(nei):
                    return False
            state[node] = 2  # mark as safe
            return True

        return [i for i in range(n) if dfs(i)]
